  _QuestList:
  - _id: 0
    _QuestName_ENG: Take a Break
    _QuestCondition_ENG: Use 'relaxant' or 'rest' once
    _QuestDescription_ENG: Just rest your eyes and enjoy the reward!
    _QuestName_TH: "\u0E1E\u0E31\u0E01\u0E2A\u0E32\u0E22\u0E15\u0E32\u0E2A\u0E1A\u0E32\u0E22
      \u0E46"
    _QuestCondition_TH: "\u0E43\u0E0A\u0E49\u0E17\u0E48\u0E32 'relaxant' \u0E2B\u0E23\u0E37\u0E2D
      'rest' \u0E2D\u0E22\u0E48\u0E32\u0E07\u0E19\u0E49\u0E2D\u0E22 1 \u0E04\u0E23\u0E31\u0E49\u0E07"
    _QuestDescription_TH: "\u0E41\u0E04\u0E48\u0E1E\u0E31\u0E01\u0E2A\u0E32\u0E22\u0E15\u0E32
      \u0E01\u0E47\u0E44\u0E14\u0E49\u0E23\u0E31\u0E1A\u0E23\u0E32\u0E07\u0E27\u0E31\u0E25\u0E41\u0E25\u0E49\u0E27"
    _Type: 0
    _Currency: 100
  - _id: 1
    _QuestName_ENG: Blink and Shoot
    _QuestCondition_ENG: Use 'blink shot' once
    _QuestDescription_ENG: Shoot fast and accurately with a blink!
    _QuestName_TH: "\u0E01\u0E23\u0E30\u0E1E\u0E23\u0E34\u0E1A\u0E41\u0E25\u0E49\u0E27\u0E22\u0E34\u0E07"
    _QuestCondition_TH: "\u0E43\u0E0A\u0E49\u0E17\u0E48\u0E32 'blink shot' 1 \u0E04\u0E23\u0E31\u0E49\u0E07"
    _QuestDescription_TH: "\u0E22\u0E34\u0E07\u0E40\u0E23\u0E47\u0E27\u0E14\u0E49\u0E27\u0E22\u0E01\u0E32\u0E23\u0E01\u0E23\u0E30\u0E1E\u0E23\u0E34\u0E1A\u0E15\u0E32!"
    _Type: 0
    _Currency: 100
  - _id: 2
    _QuestName_ENG: Spin and Slide
    _QuestCondition_ENG: Use 'cyclone' or 'vertical slide' once
    _QuestDescription_ENG: Spin your gaze gently to activate the skill.
    _QuestName_TH: "\u0E2B\u0E21\u0E38\u0E19\u0E40\u0E1A\u0E32 \u0E46 \u0E41\u0E25\u0E49\u0E27\u0E44\u0E1B\u0E15\u0E48\u0E2D"
    _QuestCondition_TH: "\u0E43\u0E0A\u0E49\u0E17\u0E48\u0E32 'cyclone' \u0E2B\u0E23\u0E37\u0E2D
      'vertical slide' 1 \u0E04\u0E23\u0E31\u0E49\u0E07"
    _QuestDescription_TH: "\u0E43\u0E0A\u0E49\u0E2A\u0E32\u0E22\u0E15\u0E32\u0E1B\u0E31\u0E14\u0E2B\u0E21\u0E38\u0E19\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E40\u0E23\u0E35\u0E22\u0E01\u0E43\u0E0A\u0E49\u0E17\u0E48\u0E32"
    _Type: 1
    _Currency: 50
  - _id: 3
    _QuestName_ENG: Focus Time
    _QuestCondition_ENG: Use 'focus beam' once
    _QuestDescription_ENG: Lock your gaze on the target and fire!
    _QuestName_TH: "\u0E42\u0E1F\u0E01\u0E31\u0E2A\u0E40\u0E1B\u0E49\u0E32\u0E40\u0E14\u0E35\u0E22\u0E27"
    _QuestCondition_TH: "\u0E43\u0E0A\u0E49\u0E17\u0E48\u0E32 'focus beam' 1 \u0E04\u0E23\u0E31\u0E49\u0E07"
    _QuestDescription_TH: "\u0E42\u0E1F\u0E01\u0E31\u0E2A\u0E2A\u0E32\u0E22\u0E15\u0E32\u0E44\u0E1B\u0E22\u0E31\u0E07\u0E40\u0E1B\u0E49\u0E32\u0E41\u0E25\u0E49\u0E27\u0E1B\u0E25\u0E48\u0E2D\u0E22\u0E1E\u0E25\u0E31\u0E07"
    _Type: 0
    _Currency: 100
  - _id: 4
    _QuestName_ENG: Say Hi to Bunnyshoot
    _QuestCondition_ENG: Fight 1 'bunnyshoot' monster
    _QuestDescription_ENG: "Let\u2019s meet and defeat Bunnyshoot today!"
    _QuestName_TH: "\u0E40\u0E08\u0E2D\u0E1A\u0E31\u0E19\u0E19\u0E35\u0E48\u0E0A\u0E39\u0E49\u0E15"
    _QuestCondition_TH: "\u0E15\u0E48\u0E2D\u0E2A\u0E39\u0E49\u0E01\u0E31\u0E1A\u0E21\u0E2D\u0E19\u0E2A\u0E40\u0E15\u0E2D\u0E23\u0E4C
      'bunnyshoot' 1 \u0E15\u0E31\u0E27"
    _QuestDescription_TH: "\u0E27\u0E31\u0E19\u0E19\u0E35\u0E49\u0E21\u0E32\u0E17\u0E31\u0E01\u0E17\u0E32\u0E22\u0E01\u0E23\u0E30\u0E15\u0E48\u0E32\u0E22\u0E19\u0E31\u0E01\u0E22\u0E34\u0E07\u0E01\u0E31\u0E19"
    _Type: 0
    _Currency: 100
  - _id: 5
    _QuestName_ENG: Quick Stretch
    _QuestCondition_ENG: Use 'stretching' once
    _QuestDescription_ENG: Loosen up with a light eye-stretch move.
    _QuestName_TH: "\u0E22\u0E37\u0E14\u0E01\u0E25\u0E49\u0E32\u0E21\u0E40\u0E19\u0E37\u0E49\u0E2D\u0E15\u0E32"
    _QuestCondition_TH: "\u0E43\u0E0A\u0E49\u0E17\u0E48\u0E32 'stretching' 1 \u0E04\u0E23\u0E31\u0E49\u0E07"
    _QuestDescription_TH: "\u0E1C\u0E48\u0E2D\u0E19\u0E04\u0E25\u0E32\u0E22\u0E2A\u0E32\u0E22\u0E15\u0E32\u0E14\u0E49\u0E27\u0E22\u0E17\u0E48\u0E32\u0E40\u0E1A\u0E32
      \u0E46"
    _Type: 0
    _Currency: 100
  - _id: 6
    _QuestName_ENG: Air Slice
    _QuestCondition_ENG: Use 'horizon slice' once
    _QuestDescription_ENG: Cut through the air with your focused gaze.
    _QuestName_TH: "\u0E1F\u0E31\u0E19\u0E2D\u0E32\u0E01\u0E32\u0E28"
    _QuestCondition_TH: "\u0E43\u0E0A\u0E49\u0E17\u0E48\u0E32 'horizon slice' 1 \u0E04\u0E23\u0E31\u0E49\u0E07"
    _QuestDescription_TH: "\u0E1F\u0E31\u0E19\u0E25\u0E21\u0E14\u0E49\u0E27\u0E22\u0E1E\u0E25\u0E31\u0E07\u0E2A\u0E32\u0E22\u0E15\u0E32"
    _Type: 1
    _Currency: 50
  - _id: 7
    _QuestName_ENG: X Mark
    _QuestCondition_ENG: Use 'x strike' once
    _QuestDescription_ENG: Form an X with your eyes and strike!
    _QuestName_TH: "\u0E1F\u0E32\u0E14\u0E40\u0E1B\u0E47\u0E19 X"
    _QuestCondition_TH: "\u0E43\u0E0A\u0E49\u0E17\u0E48\u0E32 'x strike' 1 \u0E04\u0E23\u0E31\u0E49\u0E07"
    _QuestDescription_TH: "\u0E23\u0E27\u0E21\u0E2A\u0E32\u0E22\u0E15\u0E32\u0E40\u0E1B\u0E47\u0E19\u0E23\u0E39\u0E1B
      X \u0E41\u0E25\u0E49\u0E27\u0E42\u0E08\u0E21\u0E15\u0E35!"
    _Type: 0
    _Currency: 100
  - _id: 8
    _QuestName_ENG: Infinity Power
    _QuestCondition_ENG: Use 'infinity slash' once
    _QuestDescription_ENG: Perform a stylish infinite slash.
    _QuestName_TH: "\u0E2D\u0E34\u0E19\u0E1F\u0E34\u0E19\u0E34\u0E15\u0E35\u0E49\u0E2A\u0E41\u0E25\u0E0A"
    _QuestCondition_TH: "\u0E43\u0E0A\u0E49\u0E17\u0E48\u0E32 'infinity slash' 1
      \u0E04\u0E23\u0E31\u0E49\u0E07"
    _QuestDescription_TH: "\u0E42\u0E08\u0E21\u0E15\u0E35\u0E44\u0E21\u0E48\u0E2A\u0E34\u0E49\u0E19\u0E2A\u0E38\u0E14\u0E14\u0E49\u0E27\u0E22\u0E17\u0E48\u0E32\u0E1E\u0E34\u0E40\u0E28\u0E29"
    _Type: 1
    _Currency: 50
  - _id: 9
    _QuestName_ENG: Daily Defense
    _QuestCondition_ENG: Use 'shield' once
    _QuestDescription_ENG: Defend with your eyes like a true guardian.
    _QuestName_TH: "\u0E1B\u0E49\u0E2D\u0E07\u0E01\u0E31\u0E19\u0E2A\u0E32\u0E22\u0E15\u0E32"
    _QuestCondition_TH: "\u0E43\u0E0A\u0E49\u0E17\u0E48\u0E32 'shield' 1 \u0E04\u0E23\u0E31\u0E49\u0E07"
    _QuestDescription_TH: "\u0E1B\u0E49\u0E2D\u0E07\u0E01\u0E31\u0E19\u0E15\u0E31\u0E27\u0E40\u0E2D\u0E07\u0E14\u0E49\u0E27\u0E22\u0E1E\u0E25\u0E31\u0E07\u0E2A\u0E32\u0E22\u0E15\u0E32"
    _Type: 0
    _Currency: 100
  - _id: 10
    _QuestName_ENG: Meet Amanita
    _QuestCondition_ENG: Fight 1 'amanita'
    _QuestDescription_ENG: A cute but dangerous mushroom appears.
    _QuestName_TH: "\u0E1E\u0E1A\u0E01\u0E31\u0E1A\u0E2D\u0E30\u0E21\u0E32\u0E19\u0E34\u0E15\u0E49\u0E32"
    _QuestCondition_TH: "\u0E15\u0E48\u0E2D\u0E2A\u0E39\u0E49\u0E01\u0E31\u0E1A 'amanita'
      1 \u0E15\u0E31\u0E27"
    _QuestDescription_TH: "\u0E40\u0E2B\u0E47\u0E14\u0E2B\u0E19\u0E49\u0E32\u0E15\u0E32\u0E19\u0E48\u0E32\u0E23\u0E31\u0E01\u0E41\u0E15\u0E48\u0E19\u0E48\u0E32\u0E01\u0E25\u0E31\u0E27!"
    _Type: 1
    _Currency: 50
  - _id: 11
    _QuestName_ENG: Meet Liana
    _QuestCondition_ENG: Fight 1 'liana'
    _QuestDescription_ENG: Be careful of the vines and stay sharp.
    _QuestName_TH: "\u0E1E\u0E1A\u0E01\u0E31\u0E1A\u0E40\u0E25\u0E35\u0E22\u0E19\u0E48\u0E32"
    _QuestCondition_TH: "\u0E15\u0E48\u0E2D\u0E2A\u0E39\u0E49\u0E01\u0E31\u0E1A 'liana'
