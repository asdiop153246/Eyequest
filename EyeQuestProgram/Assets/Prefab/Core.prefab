    _QuestDescription_TH: "\u0E2B\u0E21\u0E35\u0E15\u0E01\u0E1B\u0E25\u0E32\u0E2A\u0E38\u0E14\u0E42\u0E01\u0E23\u0E18!"
    _Type: 0
    _Currency: 100
  - _id: 14
    _QuestName_ENG: Meet Bumblebee
    _QuestCondition_ENG: Fight 1 'bumblebee'
    _QuestDescription_ENG: Buzz buzz... it stings and flies.
    _QuestName_TH: "\u0E1E\u0E1A\u0E01\u0E31\u0E1A\u0E1A\u0E31\u0E21\u0E40\u0E1A\u0E34\u0E25\u0E1A\u0E35"
    _QuestCondition_TH: "\u0E15\u0E48\u0E2D\u0E2A\u0E39\u0E49\u0E01\u0E31\u0E1A 'bumblebee'
      1 \u0E15\u0E31\u0E27"
    _QuestDescription_TH: "\u0E1A\u0E34\u0E19\u0E44\u0E27 \u0E15\u0E48\u0E2D\u0E22\u0E41\u0E23\u0E07!"
