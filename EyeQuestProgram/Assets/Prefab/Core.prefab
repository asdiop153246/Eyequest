    _QuestName_TH: "\u0E1E\u0E1A\u0E01\u0E31\u0E1A\u0E2A\u0E04\u0E27\u0E34\u0E14\u0E1A\u0E2D\u0E21\u0E40\u0E1A\u0E2D\u0E23\u0E4C"
