    _QuestName_ENG: Meet Insect-boy
    _QuestCondition_ENG: Fight 1 'insect-boy'
    _QuestDescription_ENG: Tiny but speedy! Defeat him fast.
    _QuestName_TH: "\u0E1E\u0E1A\u0E01\u0E31\u0E1A\u0E2D\u0E34\u0E19\u0E40\u0E0B\u0E04\u0E17\u0E4C\u0E1A\u0E2D\u0E22"
    _QuestCondition_TH: "\u0E15\u0E48\u0E2D\u0E2A\u0E39\u0E49\u0E01\u0E31\u0E1A 'insect-boy'
      1 \u0E15\u0E31\u0E27"
    _QuestDescription_TH: "\u0E15\u0E31\u0E27\u0E40\u0E25\u0E47\u0E01\u0E41\u0E15\u0E48\u0E40\u0E23\u0E47\u0E27!"
    _Type: 0
    _Currency: 100
  - _id: 13
    _QuestName_ENG: Meet Fisherbear
    _QuestCondition_ENG: Fight 1 'fisherbear'
    _QuestDescription_ENG: An angry bear with a fishing rod!
    _QuestName_TH: "\u0E1E\u0E1A\u0E01\u0E31\u0E1A\u0E1F\u0E34\u0E0A\u0E40\u0E0A\u0E2D\u0E23\u0E4C\u0E41\u0E1A\u0E23\u0E4C"
