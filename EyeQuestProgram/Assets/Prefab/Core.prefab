    _QuestDescription_ENG: Face a magical mini-boss with power.
    _QuestName_TH: "\u0E1E\u0E1A\u0E01\u0E31\u0E1A\u0E14\u0E23\u0E32\u0E01\u0E49\u0E2D\u0E19\u0E27\u0E34\u0E17\u0E0A\u0E4C"
